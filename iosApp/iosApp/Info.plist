<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>GameroProduct</key>
	<string>$(GAMERO_PRODUCT)</string>
	<key>GameroWebURL</key>
	<string>$(GAMERO_WEB_URL)</string>
	<key>NSCameraUsageDescription</key>
	<string>Hovel uses the camera when you turn on your video in a meeting.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Hovel uses the microphone so people in a meeting can hear you.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
