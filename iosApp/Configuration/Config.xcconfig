TEAM_ID=

PRODUCT_NAME=WestbergWrapper
PRODUCT_BUNDLE_IDENTIFIER=org.formulagen.wrapper.WestbergWrapper$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// Web app the shell loads. Overridden at launch by the GAMERO_WEB_URL environment variable.
// xcconfig treats `//` as a comment, so the scheme separator is written as `/$()/`.
GAMERO_WEB_URL=http:/$()/127.0.0.1:8080/hovel
// Release keeps the production URL the app loaded before Hovel; loopback only works on a simulator.
GAMERO_WEB_URL[config=Release]=https:/$()/web.worldwinner.com

// Product the shell runs. `hovel` opens the web app at once with Hovel's host bridge; the page draws its own
// launch screen. Overridden at launch by the GAMERO_PRODUCT environment variable.
// Release leaves it empty; tools/build-release.sh sets it for the archive.
GAMERO_PRODUCT=hovel
GAMERO_PRODUCT[config=Release]=

// The name under the icon and in the system's permission prompts ("Hovel would like to access the Microphone").
// Debug runs Hovel; Release keeps the target's name unless tools/ios-info.py names the product.
APP_DISPLAY_NAME=Hovel
APP_DISPLAY_NAME[config=Release]=$(PRODUCT_NAME)

// The host whose links open the app. A sign-in code is an https link on the web app's own address, and the phone's
// camera hands such a link to the app (iosApp/iosApp.entitlements, links/IncomingLink.kt). This is the host name of
// GAMERO_WEB_URL and nothing more: iOS hands over a link only for a host name on the default HTTPS port. With a
// port, with `localhost` or with a number address it downloads the address's link file and still opens the link in
// Safari (game-platform docs/qr-sign-in/qr-sign-in.LOCAL.md). A build with another web address sets this with it.
// The default names a host that cannot exist, so a build with no HTTPS host name claims no links.
GAMERO_LINK_HOST=link.invalid
// A development build reads the address's link file from the address itself, not from Apple's copy of it, and
// accepts a certificate the phone does not trust. A phone needs Settings > Developer > Associated Domains
// Development turned on; a simulator has it on. Release leaves this empty.
GAMERO_LINK_MODE=?mode=developer
GAMERO_LINK_MODE[config=Release]=
CODE_SIGN_ENTITLEMENTS=iosApp/iosApp.entitlements

// composeApp has no iosX64 target (see composeApp/build.gradle.kts), so simulators are arm64 only.
EXCLUDED_ARCHS[sdk=iphonesimulator*]=x86_64

// Kokoro, the Mac's chat voice, on the phone: scripts/ios-voice.sh writes this file with this machine's paths to
// sherpa-onnx and the model. Without it the app links no sherpa and speaks with the system voice.
#include? "Voice.local.xcconfig"
