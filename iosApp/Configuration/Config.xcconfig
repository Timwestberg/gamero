TEAM_ID=

PRODUCT_NAME=WestbergWrapper
PRODUCT_BUNDLE_IDENTIFIER=org.formulagen.wrapper.WestbergWrapper$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// Web app the shell loads. Overridden at launch by the GAMERO_WEB_URL environment variable.
// xcconfig treats `//` as a comment, so the scheme separator is written as `/$()/`.
GAMERO_WEB_URL=http:/$()/127.0.0.1:8080/hovel.html
// Release keeps the production URL the app loaded before Hovel; loopback only works on a simulator.
GAMERO_WEB_URL[config=Release]=https:/$()/web.worldwinner.com

// Product the shell runs. `hovel` adds Hovel's capabilities to the host bridge; anything else adds none.
// Overridden at launch by the GAMERO_PRODUCT environment variable.
GAMERO_PRODUCT=hovel
// Release loads web.worldwinner.com, which is not Hovel.
GAMERO_PRODUCT[config=Release]=gamero

// composeApp has no iosX64 target (see composeApp/build.gradle.kts), so simulators are arm64 only.
EXCLUDED_ARCHS[sdk=iphonesimulator*]=x86_64
