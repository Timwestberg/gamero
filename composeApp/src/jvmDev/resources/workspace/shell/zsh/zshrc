# Hovel workspace, zsh step 3 of 4 (.zshrc). See .zshenv.

if (( ${+__hovel_user_zdotdir} )); then ZDOTDIR=$__hovel_user_zdotdir; else unset ZDOTDIR; fi
# macOS's /etc/zshrc set HISTFILE from ZDOTDIR while it was still Hovel's folder. Point it where
# it points in the player's own terminal, so history stays theirs.
if [[ $HISTFILE == "$__hovel_zdotdir/.zsh_history" ]]; then
  HISTFILE=${ZDOTDIR:-$HOME}/.zsh_history
fi
if [[ ${ZDOTDIR:-$HOME} != "$__hovel_zdotdir" && -r ${ZDOTDIR:-$HOME}/.zshrc ]]; then
  builtin source "${ZDOTDIR:-$HOME}/.zshrc"
fi
if (( ${+ZDOTDIR} )); then __hovel_user_zdotdir=$ZDOTDIR; else unset __hovel_user_zdotdir; fi
ZDOTDIR=$__hovel_zdotdir

# Hovel's entries first after the player's rc, and before every prompt. The hook is added last, so
# it runs after the player's own precmd hooks (mise, direnv, fnm) have changed PATH.
__hovel_prepend_path
autoload -Uz add-zsh-hook && add-zsh-hook precmd __hovel_prepend_path
