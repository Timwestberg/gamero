# Hovel workspace, zsh step 2 of 4 (.zprofile). See .zshenv. zsh has just read /etc/zprofile,
# whose path_helper moved Hovel's entries to the end of PATH; step 3 puts them first again.

ZDOTDIR=$__hovel_user_zdotdir
if [[ $ZDOTDIR != $__hovel_zdotdir && -r $ZDOTDIR/.zprofile ]]; then
  builtin source "$ZDOTDIR/.zprofile"
fi
__hovel_user_zdotdir=$ZDOTDIR
ZDOTDIR=$__hovel_zdotdir
