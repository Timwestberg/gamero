<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Hovel meetings: the WebView gives these only to the trusted Hovel page (bridge/AndroidMediaGrant.kt). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- A phone without a camera can still join with its microphone. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".GameroApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- singleTask: a link opened from the camera goes to the running app (onNewIntent), not to a second copy of
             it inside the camera's task. -->
        <activity
            android:exported="true"
            android:launchMode="singleTask"
            android:name=".MainActivity"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A sign-in code is an https link on the web app's own address, under /link/. Android hands it to the
                 app once the address names the app in /.well-known/assetlinks.json (autoVerify). The host comes from
                 the gamero.linkHost Gradle property, by default the host of gamero.webUrl; any port matches.
                 links/IncomingLink.kt decides whether the web view may open a link. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="${gameroLinkHost}"
                    android:pathPrefix="/link/"
                    android:scheme="https" />
            </intent-filter>
        </activity>
    </application>

</manifest>